{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!plugins/walkthrough/server",
      "!**/dist",
      "!schemas",
      "!**/plan.schema.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "always" }
  },
  "overrides": [
    {
      "includes": ["packages/server/src/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": { "level": "error", "options": { "allow": ["error"] } }
          }
        }
      }
    }
  ]
}
