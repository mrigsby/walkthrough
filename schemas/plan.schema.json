{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The name of the test."
    },
    "description": {
      "type": "string"
    },
    "baseUrl": {
      "description": "The start page: a full URL, or a path like \"/admin\" on the site of the environment.",
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "string",
          "pattern": "^\\/(?!\\/)"
        }
      ]
    },
    "environment": {
      "description": "The environment to run in, like staging, when the tool call and the session do not choose one.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "environments": {
      "description": "The only environments this plan may run in, like [development, staging].",
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "vars": {
      "description": "Values for {{var:NAME}} in this plan. An environment in config.yaml can change them.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "mode": {
      "description": "interactive: confirm every step. checkpoints: confirm marked steps. autonomous: the agent checks each step.",
      "type": "string",
      "enum": [
        "interactive",
        "checkpoints",
        "autonomous"
      ]
    },
    "device": {
      "description": "Screen preset: desktop, laptop, tablet, mobile, or a Puppeteer device name.",
      "type": "string"
    },
    "colorScheme": {
      "description": "Light or dark mode.",
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "network": {
      "description": "Network speed.",
      "type": "string",
      "enum": [
        "normal",
        "slow-3g",
        "fast-3g",
        "slow-4g",
        "fast-4g",
        "offline"
      ]
    },
    "emulate": {
      "description": "More settings for every tab, like { timezone: Europe/Berlin, cpu: 4 }. device, colorScheme, and network above win over the same keys here.",
      "type": "object",
      "properties": {
        "device": {
          "description": "desktop, laptop, tablet, mobile, default, or a Puppeteer device name like \"Pixel 5\".",
          "type": "string"
        },
        "colorScheme": {
          "description": "Light or dark mode.",
          "type": "string",
          "enum": [
            "light",
            "dark",
            "system"
          ]
        },
        "network": {
          "description": "Network speed.",
          "type": "string",
          "enum": [
            "normal",
            "slow-3g",
            "fast-3g",
            "slow-4g",
            "fast-4g",
            "offline"
          ]
        },
        "cpu": {
          "description": "Make the CPU slower by this factor, like 4. 1 is normal speed.",
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "timezone": {
          "description": "A time zone like \"Europe/Berlin\", or \"system\".",
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "description": "A language and region like \"de-DE\", or \"system\". It changes date and number formats and the Accept-Language header.",
          "type": "string",
          "minLength": 1
        },
        "geolocation": {
          "description": "A place like { latitude: 52.52, longitude: 13.4 }. It also allows location for the login. \"off\" blocks location for the login.",
          "anyOf": [
            {
              "type": "string",
              "const": "off"
            },
            {
              "type": "object",
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "accuracy": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "latitude",
                "longitude"
              ],
              "additionalProperties": false
            }
          ]
        },
        "reducedMotion": {
          "description": "The prefers-reduced-motion setting.",
          "type": "string",
          "enum": [
            "reduce",
            "no-preference",
            "system"
          ]
        },
        "media": {
          "description": "Show the page as on screen or as printed.",
          "type": "string",
          "enum": [
            "screen",
            "print"
          ]
        },
        "permissions": {
          "description": "Browser permissions. They apply to every tab of the same login.",
          "type": "object",
          "properties": {
            "geolocation": {
              "type": "string",
              "enum": [
                "grant",
                "deny",
                "prompt"
              ]
            },
            "notifications": {
              "type": "string",
              "enum": [
                "grant",
                "deny",
                "prompt"
              ]
            },
            "clipboard": {
              "type": "string",
              "enum": [
                "grant",
                "deny",
                "prompt"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "session": {
      "description": "A saved login to use. Save one with the session tool.",
      "type": "string"
    },
    "screenshotDir": {
      "description": "The folder for step screenshot paths, from the project folder, like \"docs/images/help\".",
      "type": "string",
      "minLength": 1
    },
    "accessibility": {
      "description": "Settings for accessibility checks in this plan.",
      "type": "object",
      "properties": {
        "report": {
          "description": "Write an accessibility report when the run ends.",
          "type": "boolean"
        },
        "standard": {
          "description": "The standard to check against.",
          "type": "string",
          "enum": [
            "wcag2a",
            "wcag2aa",
            "wcag21aa",
            "wcag22aa"
          ]
        },
        "checks": {
          "type": "object",
          "properties": {
            "keyboard": {
              "type": "boolean"
            },
            "darkMode": {
              "type": "boolean"
            },
            "reflow": {
              "type": "boolean"
            },
            "frames": {
              "type": "boolean"
            },
            "screenshots": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "description": "Turn extra checks on or off: keyboard, darkMode, reflow, frames, screenshots."
        }
      },
      "additionalProperties": false
    },
    "lighthouse": {
      "description": "Settings for the Lighthouse steps in this plan.",
      "type": "object",
      "properties": {
        "device": {
          "description": "desktop or mobile scores. The default comes from config.yaml.",
          "type": "string",
          "enum": [
            "desktop",
            "mobile"
          ]
        },
        "categories": {
          "description": "The categories to check. The default comes from config.yaml.",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "performance",
              "accessibility",
              "best-practices",
              "seo",
              "agentic-browsing"
            ]
          }
        },
        "report": {
          "description": "Write a Lighthouse report when the run ends.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "video": {
      "description": "Record the whole run as a video. The report shows it.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "description": "mp4, webm, or gif.",
              "type": "string",
              "enum": [
                "mp4",
                "webm",
                "gif"
              ]
            },
            "path": {
              "description": "Also save the video to this file, from the project folder.",
              "type": "string",
              "minLength": 1,
              "pattern": "\\.(mp4|webm|gif)$"
            },
            "showPanel": {
              "description": "Show the Walkthrough panel in the video.",
              "type": "boolean"
            },
            "captions": {
              "description": "Show step captions at the bottom.",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "presentation": {
      "description": "Settings to play this plan as a live presentation. See docs/presentations.md.",
      "type": "object",
      "properties": {
        "title": {
          "description": "A slide before the presentation starts. It shows until the presenter clicks Start.",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "image": {
                  "type": "string",
                  "minLength": 1,
                  "description": "An image file from the project folder, like \".walkthrough/slides/title.png\"."
                },
                "fit": {
                  "description": "contain shows all of the image (default). cover fills the window and can cut the edges.",
                  "type": "string",
                  "enum": [
                    "contain",
                    "cover"
                  ]
                },
                "background": {
                  "description": "The color around the image. The default is black.",
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
                }
              },
              "required": [
                "image"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "Big text in the middle of the screen."
                },
                "text": {
                  "description": "Smaller text under the title.",
                  "type": "string",
                  "maxLength": 1000
                },
                "background": {
                  "description": "The color of the slide. The default is dark gray.",
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
                },
                "color": {
                  "description": "The color of the text. The default is white.",
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
                }
              },
              "required": [
                "title"
              ],
              "additionalProperties": false
            }
          ]
        },
        "end": {
          "description": "The last screen. Without it, the end screen shows the plan name and \"Questions?\".",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "image": {
                  "type": "string",
                  "minLength": 1,
                  "description": "An image file from the project folder, like \".walkthrough/slides/title.png\"."
                },
                "fit": {
                  "description": "contain shows all of the image (default). cover fills the window and can cut the edges.",
                  "type": "string",
                  "enum": [
                    "contain",
                    "cover"
                  ]
                },
                "background": {
                  "description": "The color around the image. The default is black.",
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
                }
              },
              "required": [
                "image"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "Big text in the middle of the screen."
                },
                "text": {
                  "description": "Smaller text under the title.",
                  "type": "string",
                  "maxLength": 1000
                },
                "background": {
                  "description": "The color of the slide. The default is dark gray.",
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
                },
                "color": {
                  "description": "The color of the text. The default is white.",
                  "type": "string",
                  "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
                }
              },
              "required": [
                "title"
              ],
              "additionalProperties": false
            }
          ]
        },
        "pause": {
          "description": "before (default): wait for the presenter before each step. none: go on by itself.",
          "type": "string",
          "enum": [
            "before",
            "none"
          ]
        },
        "pace": {
          "description": "How fast the pointer moves and the text types. The default is normal.",
          "type": "string",
          "enum": [
            "slow",
            "normal",
            "fast"
          ]
        },
        "pointer": {
          "description": "Show a pointer that moves to each element. Default: true.",
          "type": "boolean"
        },
        "spotlight": {
          "description": "During a pause, dim the page except the element of the next action. Default: true.",
          "type": "boolean"
        },
        "captions": {
          "description": "Show the caption of each step at the bottom of the audience screen. Default: true.",
          "type": "boolean"
        },
        "window": {
          "description": "The size of the audience window, like { width: 1920, height: 1080 }.",
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 640,
              "maximum": 3840
            },
            "height": {
              "type": "integer",
              "minimum": 480,
              "maximum": 2160
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "pageZoom": {
          "description": "Make the page bigger, like 1.25, so people at the back of the room can read it.",
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "fullscreen": {
          "description": "Start the audience window in fullscreen.",
          "type": "boolean"
        },
        "device": {
          "description": "Use the device of the plan, like mobile, on the audience screen. Default: the page fills the window.",
          "type": "boolean"
        },
        "mirror": {
          "description": "Show a small live picture of the audience screen in the presenter window. Default: true.",
          "type": "boolean"
        },
        "timeBudget": {
          "description": "The time for the whole presentation, like \"10m\". The presenter window warns when it is over.",
          "type": "string",
          "pattern": "^(?=\\d)(?:(\\d+)h)?(?:(\\d+)m)?(?:(\\d+)s)?$"
        },
        "mask": {
          "description": "CSS selectors of things to blur on the audience screen, like customer names. Secret fields are always blurred.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "record": {
          "description": "Record the audience screen as a video.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "properties": {
                "format": {
                  "description": "mp4, webm, or gif.",
                  "type": "string",
                  "enum": [
                    "mp4",
                    "webm",
                    "gif"
                  ]
                },
                "path": {
                  "description": "Also save the video to this file, from the project folder.",
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\.(mp4|webm|gif)$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "kiosk": {
          "description": "Run without a presenter, such as on a screen at a booth.",
          "type": "object",
          "properties": {
            "holdSeconds": {
              "description": "How long each step and slide shows. The default is 6.",
              "type": "number",
              "minimum": 1,
              "maximum": 600
            },
            "loop": {
              "description": "Start again at the title after the end screen.",
              "type": "boolean"
            },
            "loops": {
              "description": "Stop after this many loops. The default is 100.",
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "A short id for the step. Reports and scripts use it.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "do": {
            "type": "string",
            "minLength": 1,
            "description": "What to do, in plain words."
          },
          "expect": {
            "description": "What the developer should see after the step. Make it specific.",
            "type": "string"
          },
          "checkpoint": {
            "description": "In checkpoints mode, ask the developer to confirm this step.",
            "type": "boolean"
          },
          "action": {
            "type": "object",
            "properties": {
              "navigate": {
                "description": "A URL or a path like \"/cart\".",
                "type": "string"
              },
              "click": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "dblclick": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "hover": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "fill": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "select": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "check": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "uncheck": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "press": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "scroll": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "upload": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "wait": {
                "description": "Text to wait for on the page.",
                "type": "string"
              },
              "newTab": {
                "type": "object",
                "properties": {
                  "url": {
                    "description": "The page to open. A full URL, or a path like \"/login\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "A name for the tab. Later steps switch to it by name.",
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "isolated": {
                    "description": "true for a new login of its own. A name for a login that tabs share.",
                    "anyOf": [
                      {
                        "type": "boolean",
                        "const": true
                      },
                      {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*$"
                      }
                    ]
                  },
                  "session": {
                    "description": "A saved login to load into the tab.",
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "switchTab": {
                "description": "The tab to use now: a name, or \"newest\" for the tab that opened last. { tab: newest, name: help } also names it.",
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "properties": {
                      "tab": {
                        "type": "string",
                        "minLength": 1,
                        "description": "A tab name, an id, or \"newest\"."
                      },
                      "name": {
                        "description": "A name to give the tab.",
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*$"
                      }
                    },
                    "required": [
                      "tab"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "closeTab": {
                "description": "The name or id of the tab to close.",
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "description": "An exact action for this step. The agent uses it instead of guessing."
          },
          "screenshot": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\.(png|jpe?g|webp)$",
                "description": "Where to save the file, from the project folder or from screenshotDir."
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\.(png|jpe?g|webp)$",
                    "description": "Where to save the file, from the project folder or from screenshotDir."
                  },
                  "selector": {
                    "description": "Capture only this element.",
                    "type": "string"
                  },
                  "fullPage": {
                    "description": "Capture the whole page, not only the visible part.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Save a screenshot after this step. true saves it with the run. A path saves it to that exact file, and replaces the file if it exists."
          },
          "visual": {
            "description": "Compare a screenshot with the saved baseline after this step.",
            "type": "boolean"
          },
          "emulate": {
            "description": "Settings for the tab of this step, like { device: mobile }. They apply before the step.",
            "type": "object",
            "properties": {
              "device": {
                "description": "desktop, laptop, tablet, mobile, default, or a Puppeteer device name like \"Pixel 5\".",
                "type": "string"
              },
              "colorScheme": {
                "description": "Light or dark mode.",
                "type": "string",
                "enum": [
                  "light",
                  "dark",
                  "system"
                ]
              },
              "network": {
                "description": "Network speed.",
                "type": "string",
                "enum": [
                  "normal",
                  "slow-3g",
                  "fast-3g",
                  "slow-4g",
                  "fast-4g",
                  "offline"
                ]
              },
              "cpu": {
                "description": "Make the CPU slower by this factor, like 4. 1 is normal speed.",
                "type": "number",
                "minimum": 1,
                "maximum": 20
              },
              "timezone": {
                "description": "A time zone like \"Europe/Berlin\", or \"system\".",
                "type": "string",
                "minLength": 1
              },
              "locale": {
                "description": "A language and region like \"de-DE\", or \"system\". It changes date and number formats and the Accept-Language header.",
                "type": "string",
                "minLength": 1
              },
              "geolocation": {
                "description": "A place like { latitude: 52.52, longitude: 13.4 }. It also allows location for the login. \"off\" blocks location for the login.",
                "anyOf": [
                  {
                    "type": "string",
                    "const": "off"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      },
                      "accuracy": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "reducedMotion": {
                "description": "The prefers-reduced-motion setting.",
                "type": "string",
                "enum": [
                  "reduce",
                  "no-preference",
                  "system"
                ]
              },
              "media": {
                "description": "Show the page as on screen or as printed.",
                "type": "string",
                "enum": [
                  "screen",
                  "print"
                ]
              },
              "permissions": {
                "description": "Browser permissions. They apply to every tab of the same login.",
                "type": "object",
                "properties": {
                  "geolocation": {
                    "type": "string",
                    "enum": [
                      "grant",
                      "deny",
                      "prompt"
                    ]
                  },
                  "notifications": {
                    "type": "string",
                    "enum": [
                      "grant",
                      "deny",
                      "prompt"
                    ]
                  },
                  "clipboard": {
                    "type": "string",
                    "enum": [
                      "grant",
                      "deny",
                      "prompt"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "cookies": {
            "description": "Cookie checks after this step, like [{ name: session, httpOnly: true }].",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The cookie name, like \"session\"."
                },
                "exists": {
                  "description": "false checks that the cookie is gone. The default is true.",
                  "type": "boolean"
                },
                "value": {
                  "description": "The exact value. {{secret:NAME}} and {{unique}} work here.",
                  "type": "string"
                },
                "contains": {
                  "description": "Text that the value has in it.",
                  "type": "string"
                },
                "httpOnly": {
                  "type": "boolean"
                },
                "secure": {
                  "type": "boolean"
                },
                "sameSite": {
                  "type": "string",
                  "enum": [
                    "Strict",
                    "Lax",
                    "None"
                  ]
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "mock": {
            "description": "Mock rules to add before this step, like [{ url: /api/stock, status: 500 }]. They stay on for later steps. \"off\" removes all mocks.",
            "anyOf": [
              {
                "type": "string",
                "const": "off"
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "description": "The address to match. \"/api/stock\" matches the path on any site. A full URL or a pattern with * matches the whole address.",
                      "type": "string",
                      "minLength": 1
                    },
                    "urlRegex": {
                      "description": "A regular expression for the whole address.",
                      "type": "string",
                      "minLength": 1
                    },
                    "method": {
                      "description": "Only this method, like \"POST\".",
                      "type": "string"
                    },
                    "type": {
                      "description": "Only this resource type, like \"fetch\", \"xhr\", \"document\", \"image\", or \"script\".",
                      "type": "string"
                    },
                    "tab": {
                      "description": "Only this tab, by name or id. Default: every tab.",
                      "type": "string"
                    },
                    "status": {
                      "description": "The status to answer with.",
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    },
                    "json": {
                      "description": "A JSON body to answer with."
                    },
                    "body": {
                      "description": "A text body to answer with.",
                      "type": "string"
                    },
                    "headers": {
                      "description": "Headers to answer with.",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "contentType": {
                      "description": "The content type. Default: from json or text.",
                      "type": "string"
                    },
                    "delayMs": {
                      "description": "Wait this long first.",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 60000
                    },
                    "block": {
                      "description": "Fail the request, as if the network blocked it.",
                      "type": "boolean"
                    },
                    "times": {
                      "description": "Use the rule this many times, then stop.",
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  },
                  "additionalProperties": false
                }
              }
            ]
          },
          "a11y": {
            "description": "Check accessibility after this step.",
            "anyOf": [
              {
                "type": "boolean",
                "const": true
              },
              {
                "type": "object",
                "properties": {
                  "selector": {
                    "description": "Check only this part of the page.",
                    "type": "string",
                    "minLength": 1
                  },
                  "checks": {
                    "description": "Extra checks for this step, like [keyboard, darkMode].",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "keyboard",
                        "darkMode",
                        "reflow",
                        "frames",
                        "screenshots"
                      ]
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "caption": {
            "description": "The text viewers see in a video of this step. Without it, videos show \"do\".",
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "lighthouse": {
            "description": "Measure this step with Lighthouse. navigation: Lighthouse loads the page of the navigate action. timespan: it measures what the step does. snapshot: it checks the page after the step.",
            "type": "string",
            "enum": [
              "navigation",
              "timespan",
              "snapshot"
            ]
          },
          "notes": {
            "description": "Notes for the presenter. Only the presenter window shows them.",
            "type": "string",
            "maxLength": 4000
          },
          "pause": {
            "description": "In a presentation, wait for the presenter before this step. false goes on by itself. The default comes from presentation.pause.",
            "type": "boolean"
          },
          "slide": {
            "description": "A slide before the action of this step, or the whole step when it has no action. Test runs skip a step that is only a slide.",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "minLength": 1,
                    "description": "An image file from the project folder, like \".walkthrough/slides/title.png\"."
                  },
                  "fit": {
                    "description": "contain shows all of the image (default). cover fills the window and can cut the edges.",
                    "type": "string",
                    "enum": [
                      "contain",
                      "cover"
                    ]
                  },
                  "background": {
                    "description": "The color around the image. The default is black.",
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
                  }
                },
                "required": [
                  "image"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "description": "Big text in the middle of the screen."
                  },
                  "text": {
                    "description": "Smaller text under the title.",
                    "type": "string",
                    "maxLength": 1000
                  },
                  "background": {
                    "description": "The color of the slide. The default is dark gray.",
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
                  },
                  "color": {
                    "description": "The color of the text. The default is white.",
                    "type": "string",
                    "pattern": "^#(?:[0-9a-fA-F]{3}){1,2}$"
                  }
                },
                "required": [
                  "title"
                ],
                "additionalProperties": false
              }
            ]
          },
          "spotlight": {
            "description": "In a presentation, dim the page except the element of this step during the pause.",
            "type": "boolean"
          },
          "zoom": {
            "description": "In a presentation, show the area of the next action this many times bigger during the pause.",
            "type": "number",
            "minimum": 1.25,
            "maximum": 4
          },
          "timeBudget": {
            "description": "The time for this step in a presentation, like \"45s\".",
            "type": "string",
            "pattern": "^(?=\\d)(?:(\\d+)h)?(?:(\\d+)m)?(?:(\\d+)s)?$"
          }
        },
        "required": [
          "do"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "steps"
  ],
  "additionalProperties": false,
  "title": "Walkthrough test plan"
}
