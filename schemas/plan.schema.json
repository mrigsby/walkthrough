{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The name of the test."
    },
    "description": {
      "type": "string"
    },
    "baseUrl": {
      "description": "The start page. Overrides baseUrl in config.yaml.",
      "type": "string",
      "format": "uri"
    },
    "mode": {
      "description": "interactive: confirm every step. checkpoints: confirm marked steps. autonomous: the agent checks each step.",
      "type": "string",
      "enum": [
        "interactive",
        "checkpoints",
        "autonomous"
      ]
    },
    "device": {
      "description": "Screen preset: desktop, laptop, tablet, mobile, or a Puppeteer device name.",
      "type": "string"
    },
    "colorScheme": {
      "description": "Light or dark mode.",
      "type": "string",
      "enum": [
        "light",
        "dark"
      ]
    },
    "network": {
      "description": "Network speed.",
      "type": "string",
      "enum": [
        "normal",
        "slow-3g",
        "fast-3g",
        "slow-4g",
        "fast-4g",
        "offline"
      ]
    },
    "session": {
      "description": "A saved login to use. Save one with the session tool.",
      "type": "string"
    },
    "screenshotDir": {
      "description": "The folder for step screenshot paths, from the project folder, like \"docs/images/help\".",
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "A short id for the step. Reports and scripts use it.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "do": {
            "type": "string",
            "minLength": 1,
            "description": "What to do, in plain words."
          },
          "expect": {
            "description": "What the developer should see after the step. Make it specific.",
            "type": "string"
          },
          "checkpoint": {
            "description": "In checkpoints mode, ask the developer to confirm this step.",
            "type": "boolean"
          },
          "action": {
            "type": "object",
            "properties": {
              "navigate": {
                "description": "A URL or a path like \"/cart\".",
                "type": "string"
              },
              "click": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "dblclick": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "hover": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "fill": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "select": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "check": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "uncheck": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "press": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "scroll": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "upload": {
                "type": "object",
                "properties": {
                  "role": {
                    "description": "ARIA role, like \"button\" or \"textbox\".",
                    "type": "string"
                  },
                  "name": {
                    "description": "The name the user sees, like \"Checkout\".",
                    "type": "string"
                  },
                  "selector": {
                    "description": "A CSS or Puppeteer selector.",
                    "type": "string"
                  },
                  "value": {
                    "description": "Text to type, option to choose, or key to press.",
                    "type": "string"
                  },
                  "files": {
                    "description": "Files to upload, from the project folder.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "wait": {
                "description": "Text to wait for on the page.",
                "type": "string"
              }
            },
            "additionalProperties": false,
            "description": "An exact action for this step. The agent uses it instead of guessing."
          },
          "screenshot": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\.(png|jpe?g|webp)$",
                "description": "Where to save the file, from the project folder or from screenshotDir."
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\.(png|jpe?g|webp)$",
                    "description": "Where to save the file, from the project folder or from screenshotDir."
                  },
                  "selector": {
                    "description": "Capture only this element.",
                    "type": "string"
                  },
                  "fullPage": {
                    "description": "Capture the whole page, not only the visible part.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Save a screenshot after this step. true saves it with the run. A path saves it to that exact file, and replaces the file if it exists."
          },
          "visual": {
            "description": "Compare a screenshot with the saved baseline after this step.",
            "type": "boolean"
          }
        },
        "required": [
          "do"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "steps"
  ],
  "additionalProperties": false,
  "title": "Walkthrough test plan"
}
